# 复制为项目根目录 .env；填完必填项后再启动服务。
# 已部署过的环境复用原配置，不覆盖现有数据库密码、签名密钥或 OSS 资源。

# MySQL：密码必填；已有数据库使用原密码。
# Docker Compose 会用 MYSQL_* 自动组成旅行 API 的 DATABASE_URL。
MYSQL_DATABASE=jiandi
MYSQL_USER=jiandi
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 仅宿主机直接启动 Python 时必填，并将本文件加载为进程环境变量；Docker 无需填写。
# 格式：mysql+pymysql://<用户名>:<密码>@127.0.0.1:3307/<库名>?charset=utf8mb4
# 连接串中的用户名和密码若包含特殊字符，需要 URL 编码。
DATABASE_URL=

# 登录签名密钥：必填；全新环境可用 openssl rand -hex 32 生成。
SECRET_KEY=

# 运行环境：正式部署改为 production，并保持 TEST_AUTH_ENABLED=false。
APP_ENV=development
GUEST_TOKEN_TTL_HOURS=168
AUTH_TOKEN_TTL_HOURS=168
TEST_AUTH_ENABLED=false
TEST_AUTH_USERS=tester-a,tester-b
# 本地需要测试账号登录时，再将 TEST_AUTH_ENABLED 设为 true。
# 需要模拟到达时再开启；实际定位旅行保持 false。
ALLOW_DEMO_ARRIVAL=false

# 浏览器跨域来源：按需填实际前端来源，多个地址用英文逗号分隔。
CORS_ORIGINS=*
# 可选：旅行 API 公网根地址，不带 /api/v1；App 的访问地址在打包时配置。
PUBLIC_BASE_URL=

# OSS：两个项目使用同一套现有 Bucket、地域和媒体域名。
# 除 OSS_ENDPOINT 外，下面留空的 OSS 字段均必填。
OBJECT_STORAGE_PROVIDER=oss
OSS_REGION=
# 可选：留空按地域推导；电脑本地使用公网 Endpoint。
OSS_ENDPOINT=
OSS_PUBLIC_BUCKET=
OSS_PRIVATE_BUCKET=
# 现有媒体 CDN 根地址，如 https://你的媒体域名，不是旅行 API 地址。
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_TTL_SECONDS=300
OSS_TEST_PREFIX=integration-tests

# 功能与容量限制：通常保持默认。
ENABLE_FRAGMENT_AUDIO_TOURS=true
EVIDENCE_UPLOAD_ENABLED=true
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_MAX_EDGE=4096
EVIDENCE_RETENTION_DAYS=30
COMMUNITY_ENABLED=true
COMMUNITY_TITLE_MAX_LENGTH=60
COMMUNITY_BODY_MAX_LENGTH=1200
COMMUNITY_COMMENT_MAX_LENGTH=300
COMMUNITY_MAX_MEDIA=4
COMMUNITY_MEDIA_MAX_BYTES=10485760
COMMUNITY_MEDIA_MAX_EDGE=1920
COMMUNITY_MEDIA_RETENTION_DAYS=0
COMMUNITY_MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
COMMUNITY_AUTO_HOLD_REPORT_THRESHOLD=3
