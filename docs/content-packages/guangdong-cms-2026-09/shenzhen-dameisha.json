  "story_arc": {
    "id": "a747a691-bbfd-580a-b17d-d2ed0770c8fe",
    "title": "大梅沙",
    "central_question": "海岸与公共空间 · 慢行观察",
    "complete_story": "从风信长廊的步行入口开始，让视线先越过人群，望向沙滩与海。廊桥把公园中的步行空间接在一起，沿着开放通道慢慢走，不必急着抵达海边。\n\n大梅沙沙滩东部有一组飞人雕塑。这一处在公开地图中标名为《幸福·生存》。可以沿公共通道观察它的姿态与海岸背景，不必攀爬，换一个站立角度，也会得到不同的画面。\n\n在公园东侧的观景点，把目光从近处的沙滩移向远处的海面。停留时让出通道，等海风吹过，再回看走过的长廊和雕塑。",
    "causal_model": [
      {
        "id": "b71647eb-d8c9-5354-85dc-8637bc2f90fb",
        "text": "从风信长廊的步行入口开始，让视线先越过人群，望向沙滩与海。"
      },
      {
        "id": "9bbb2ef5-e601-5410-8a70-8d0be1966559",
        "text": "大梅沙沙滩东部有一组飞人雕塑。"
      },
      {
        "id": "e3715f62-29bb-54ef-b304-60df712610fa",
        "text": "在公园东侧的观景点，把目光从近处的沙滩移向远处的海面。"
      }
    ],
